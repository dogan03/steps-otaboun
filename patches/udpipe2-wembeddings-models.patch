+        def add_special_tokens(self, subwords):
+            """[steps-otaboun] The code below assumes exactly one leading and one trailing
+            special token. Fast tokenizers without a post-processing template (ModernBERT:
+            TabiBERT, mmBERT) return the ids unchanged, so add [CLS]/[SEP] explicitly."""
+            wrapped = self.tokenizer.build_inputs_with_special_tokens(subwords)
+            if len(wrapped) == len(subwords) + 2:
+                return wrapped
+            first = self.tokenizer.cls_token_id
+            last = self.tokenizer.sep_token_id
+            if first is None:
+                first = self.tokenizer.bos_token_id
+            if last is None:
+                last = self.tokenizer.eos_token_id
+            return [first] + subwords + [last]
+
+        def _torch_embeddings(self, config):
+            """PyTorch version of the graph in load(): mean of the chosen hidden layers, then
+            the mean over each word's subwords. Returns a tensor whose .numpy() gives the same
+            [sentences, words, dim] array the TensorFlow path returns."""
+            import torch
+            import transformers
+
+            model = transformers.AutoModel.from_pretrained(self._transformers_model_name, config=config)
+            device = "cuda" if torch.cuda.is_available() else "cpu"
+            model.to(device).eval()
+            layer_start, layer_end = self._layer_start, self._layer_end
+
+            def compute(subwords, segments):
+                ids = torch.as_tensor(subwords, dtype=torch.long, device=device)
+                mask = (ids >= 0).long()
+                with torch.no_grad():
+                    hidden = model(input_ids=ids.clamp(min=0), attention_mask=mask).hidden_states
+                    # drop the leading special token, exactly as the TF path does
+                    emb = torch.stack(hidden[layer_start:layer_end], 0).mean(0)[:, 1:].float()
+                    seg = torch.as_tensor(segments, dtype=torch.long, device=device)
+                    batch, length, dim = emb.shape
+                    words = int(seg.max().item()) + 1      # padding segment id == max sentence len
+                    total = torch.zeros(batch, words, dim, dtype=emb.dtype, device=device)
+                    count = torch.zeros(batch, words, 1, dtype=emb.dtype, device=device)
+                    total.scatter_add_(1, seg.unsqueeze(-1).expand(-1, -1, dim), emb)
+                    count.scatter_add_(1, seg.unsqueeze(-1),
+                                       torch.ones(batch, length, 1, dtype=emb.dtype, device=device))
+                    return (total / count.clamp(min=1))[:, :-1].cpu()
+
+            return compute
+
 
