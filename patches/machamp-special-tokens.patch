diff --git a/machamp/utils/myutils.py b/machamp/utils/myutils.py
index ee4b807..f9a8820 100644
--- a/machamp/utils/myutils.py
+++ b/machamp/utils/myutils.py
@@ -494,3 +494,45 @@ class StreamToLogger2(object):
    def flush(self):
         pass
 
+
+def get_special_token_ids(tokenizer):
+    """[steps-otaboun] (start_id, end_id) that this tokenizer actually adds, or None each.
+
+    `prepare_for_model([])` (used before) reports 0 special tokens for some fast tokenizers
+    (e.g. ModernBERT-based ones like TabiBERT/mmBERT), while encode() does add [CLS]/[SEP].
+    That made MaChAmp keep a [CLS]/[SEP] pair inside every single word.
+    """
+    with_special = tokenizer.encode('a')
+    without_special = tokenizer.encode('a', add_special_tokens=False)
+    num_extra = len(with_special) - len(without_special)
+    if num_extra <= 0:
+        return None, None
+    if num_extra == 1:  # assume it is the end token
+        return None, with_special[-1]
+    return with_special[0], with_special[-1]
+
+
+def add_special_tokens(tokenizer, token_ids):
+    """[steps-otaboun] Wrap token ids in the tokenizer's special tokens (tensor out).
+
+    Replaces `prepare_for_model`, which is a no-op for the fast tokenizers described above.
+    """
+    start, end = get_special_token_ids(tokenizer)
+    ids = ([start] if start is not None else []) + list(token_ids) + ([end] if end is not None else [])
+    return torch.tensor(ids, dtype=torch.long)
+
+
+_PREFIX_SPACE_CACHE = {}
+
+
+def needs_prefix_space(tokenizer):
+    """[steps-otaboun] True for byte-level BPE tokenizers (GPT-2 style, 'Ġ'), e.g. ModernBERT.
+
+    Those encode a word differently depending on whether it is preceded by a space, and during
+    pre-training nearly every word is. Tokenizing words one by one without the space gives
+    subwords the model has hardly seen, which destroys accuracy.
+    """
+    key = id(tokenizer)
+    if key not in _PREFIX_SPACE_CACHE:
+        _PREFIX_SPACE_CACHE[key] = identify_tokenizer(tokenizer) == 'G'
+    return _PREFIX_SPACE_CACHE[key]
